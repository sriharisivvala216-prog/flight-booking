# =======================================================
# SkyWings Airways - Backend Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# For Render / Vercel deployment: Set these in the platform's Environment Variables dashboard.
# =======================================================

# Server Port (Render injects this dynamically; 5000 is used for local development)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/skywings_flightbooking?retryWrites=true&w=majority
# (Note: If MongoDB is unavailable or invalid, the backend automatically runs with the built-in JSON fallback in backend/data/)
MONGODB_URI=mongodb+srv://sriharisivvala216_db_user:<db_password>@cluster0.sek0ysr.mongodb.net/?appName=Cluster0

# JWT Secret Key for Authentication (generate a secure random 32+ character string)
JWT_SECRET=your_jwt_secret_key_here

# Frontend Application URL (Used for CORS permissions)
FRONTEND_URL=https://flight-booking-na5pkq022-sivvala.vercel.app
